# Copy this file to .env and fill it in. Never share .env.

# Ollama runs on the laptop (not in Docker). Pick a model that fits:
#   GPU 4 GB (Altamash): qwen2.5:7b or qwen2.5:3b    No GPU (Taha): qwen2.5:3b
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# Google API key (free, console.cloud.google.com). Enable 2 APIs for it:
#   "PageSpeed Insights API": lab tests run on Google's servers in the USA (steadier, like our ad visitors)
#   "Chrome UX Report API":   Google's real-user data in 'audit live'
# Without a key, Lighthouse runs on this laptop and 'audit live' has no Google data.
GOOGLE_API_KEY=

# Cloudflare (for 'audit live'): real ad visitors' speed from Web Analytics.
# Token: Cloudflare dashboard > My Profile > API Tokens > Create > Custom: Account / Account Analytics / Read.
# Account ID: Cloudflare dashboard, right side of the Overview page (or in the dashboard URL).
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Your own free GTmetrix account (one account per person). Leave empty to skip GTmetrix.
# The free plan only has a few tests, so the tool runs GTmetrix once per audit.
GTMETRIX_EMAIL=
GTMETRIX_PASSWORD=
