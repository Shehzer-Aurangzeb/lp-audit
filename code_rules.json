[
  {"id": "php-var-dump", "files": "\\.php$", "match": "\\b(var_dump|print_r|var_export|dd)\\s*\\(", "severity": 2, "title": "Debug output left in PHP", "fix": "Remove var_dump/print_r before launch. Visitors can see it."},
  {"id": "php-phpinfo", "files": "\\.php$", "match": "\\bphpinfo\\s*\\(", "severity": 1, "title": "phpinfo() in code", "fix": "Remove it. It shows server details to anyone."},
  {"id": "php-display-errors", "files": "\\.(php|ini)$|\\.htaccess$", "match": "display_errors['\"]?\\s*[,=]\\s*['\"]?(1|on|true)|error_reporting\\s*\\(\\s*E_ALL", "severity": 1, "title": "PHP errors shown to visitors", "fix": "Turn off display_errors on the live site. Log errors to a file instead."},
  {"id": "php-die-debug", "files": "\\.php$", "match": "\\b(die|exit)\\s*\\(\\s*['\"](test|debug|here|ok)", "severity": 2, "title": "Debug die()/exit() left in code", "fix": "Remove test die()/exit() calls."},
  {"id": "php-sql-concat", "files": "\\.php$", "match": "(mysqli_query|->query|mysql_query)\\s*\\([^;]*\\$_(GET|POST|REQUEST|COOKIE)", "severity": 1, "title": "Possible SQL injection (user input in SQL)", "fix": "Use prepared statements ($stmt = $db->prepare(...); bind_param)."},
  {"id": "php-echo-input", "files": "\\.php$", "match": "echo\\s+[^;]*\\$_(GET|POST|REQUEST)\\[", "severity": 1, "title": "User input printed without escaping (XSS)", "fix": "Wrap it: htmlspecialchars($value, ENT_QUOTES, 'UTF-8')."},
  {"id": "php-mail-header-input", "files": "\\.php$", "match": "\\bmail\\s*\\([^;]*\\$_(GET|POST|REQUEST)", "severity": 2, "title": "Form input goes straight into mail()", "fix": "Validate the email/fields first and strip new lines from header values."},
  {"id": "hardcoded-password", "files": "\\.(php|js|html|ini|json|txt)$", "match": "(pass(word)?|pwd|secret|api[_-]?key)['\"]?\\s*[:=]\\s*['\"][^'\"$ ]{6,}['\"]|PASS:\\s*\\S{6,}", "severity": 1, "title": "Password or key written in the code", "fix": "Move it to a config file outside the web folder (or env), and change the password."},
  {"id": "js-console-log", "files": "\\.(js|php|html)$", "match": "console\\.(log|debug)\\s*\\(", "severity": 3, "title": "console.log left in JavaScript", "fix": "Remove debug logging before launch."},
  {"id": "js-debugger", "files": "\\.(js|php|html)$", "match": "\\bdebugger\\s*;", "severity": 2, "title": "debugger; left in JavaScript", "fix": "Remove it."},
  {"id": "todo-left", "files": "\\.(php|js|html|css)$", "match": "\\b(TODO|FIXME|XXX|HACK)\\b", "severity": 3, "title": "TODO / FIXME notes left", "fix": "Check each one is done or not needed for launch."},
  {"id": "test-content", "files": "\\.(php|html)$", "match": "lorem ipsum|test@(test|example)\\.com|@example\\.com|http://localhost|127\\.0\\.0\\.1", "severity": 2, "title": "Test content, test email or localhost link", "fix": "Replace with the real content / real URL."},
  {"id": "http-link", "files": "\\.(php|html|css)$", "match": "(src|href)=['\"]http://(?!localhost)", "severity": 3, "title": "http:// link (not https)", "fix": "Use https:// so the browser does not block or warn."},
  {"id": "img-no-size-code", "files": "\\.(php|html)$", "match": "<img(?![^>]*\\bwidth=)[^>]*>", "severity": 3, "title": "<img> without width/height (page can jump)", "fix": "Add width and height (the real image size) to every <img>."},
  {"id": "form-no-csrf", "files": "\\.(php|html)$", "match": "<form[^>]*method=['\"]?post(?![\\s\\S]{0,2000}(csrf|_token|nonce))", "severity": 2, "title": "POST form without a CSRF token", "fix": "Add a hidden token field and check it in the PHP that handles the form."},
  {"id": "learned-link-opens-new-tab-without-rel-noopener", "files": "\\.(php|html?)$", "match": "target=[\"']_blank[\"'](?![^>]*rel=)", "severity": 2, "title": "Link opens new tab without rel=noopener", "fix": "Add rel=\"noopener\" to links with target=\"_blank\".", "learned": {"from": "example", "date": "2026-11-16", "bad_example": "<a href=\"x\" target=\"_blank\">", "good_example": "<a href=\"x\" target=\"_blank\" rel=\"noopener\">"}}
]
